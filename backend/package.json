{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:dev": "ts-node ./src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:exe": "npm run build && pkg . --targets node18-win-x64 --output dist/backend.exe",
    "dev": "nodemon",
    "db:generate": "prisma generate --schema=prisma/supabase/schema.prisma && prisma generate --schema=prisma/local/schema.prisma",
    "db:push:supabase": "prisma db push --schema=prisma/supabase/schema.prisma",
    "db:push:local": "prisma db push --schema=prisma/local/schema.prisma",
    "db:migrate:supabase": "prisma migrate dev --schema=prisma/supabase/schema.prisma --name supabase",
    "db:migrate:local": "prisma migrate dev --schema=prisma/local/schema.prisma --name local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "bin": "dist/index.js",
  "pkg": {
    "assets": [
      "prisma/**/*",
      "node_modules/.prisma/client/*.node",
      ".env"
    ],
    "scripts": [
      "dist/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@types/bonjour": "^3.5.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "nodemon": "^3.1.10",
    "prisma": "^6.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "bonjour": "^3.5.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "extract-zip": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.9"
  }
}
